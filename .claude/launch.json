{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kairos-frontend",
      "cwd": "frontend",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port=3000",
        "--dart-define=API_URL=http://localhost:5001/api"
      ],
      "port": 3000
    },
    {
      "name": "kairos-web-build",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4320",
        "--directory",
        "frontend/build/web"
      ],
      "port": 4320
    },
    {
      "name": "kairos-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4310",
        "--directory",
        "frontend/build/demo"
      ],
      "port": 4310
    }
  ]
}
