{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kairos-frontend",
      "cwd": "frontend",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port=3000",
        "--dart-define=API_URL=http://localhost:5001/api"
      ],
      "port": 3000
    },
    {
      "name": "kairos-demo",
      "cwd": "frontend/build/web",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173"],
      "port": 4173
    }
  ]
}
